{
  "name": "fetchfully",
  "version": "1.8.0",
  "description": "JavaScript Fetch API with power pack ⚡️",
  "main": "./dist/fetchfully.cjs",
  "module": "./dist/fetchfully.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "public": true,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/fetchfully.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/fetchfully.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romeopeter/fetchfully.git"
  },
  "author": "Romeo Agbor Peter",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/romeopeter/fetchfully/issues"
  },
  "homepage": "https://github.com/romeopeter/fetchfully#readme",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-dts": "^4.4.0"
  }
}
